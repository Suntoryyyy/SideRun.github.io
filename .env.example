# SideRun env template — copy this file to `.env` and fill in real values.
# Expo only exposes variables with the `EXPO_PUBLIC_` prefix to the client bundle.

# Supabase / MemFire Cloud project
EXPO_PUBLIC_SUPABASE_URL=https://your-project.memfiredb.com
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Optional: OpenWeatherMap (see WeatherScreen.js)
# EXPO_PUBLIC_OPENWEATHER_API_KEY=
